TETHERKIT_MESSAGE(kNetSysctlMismatch,
                  "sysctl {0} 当前是 {1}，要求 {2}。原因：{3}。\n"
                  "  这个开关在 feth 创建时被快照进接口，创建后再改无效，因此必须先修正：\n"
                  "    sudo sysctl -w {0}={2}",
                  "sysctl {0} is currently {1} but must be {2}. Reason: {3}.\n"
                  "  feth snapshots this switch into the interface at creation time, so changing "
                  "it afterwards has no effect. Fix it first:\n"
                  "    sudo sysctl -w {0}={2}")
TETHERKIT_MESSAGE(kNetSysctlWhyHwcsum,
                  "非 0 时出站帧的 IP/TCP/UDP 校验和是留给硬件计算的占位值，我们读到的帧校验和无效",
                  "when non-zero, IP/TCP/UDP checksums on outbound frames are placeholders left "
                  "for hardware to compute, so the frames we read have invalid checksums")
TETHERKIT_MESSAGE(kNetSysctlWhyFcs, "非 0 时会在帧尾追加 4 字节 CRC，转发到 USB 前需要额外剥离",
                  "when non-zero, a 4-byte CRC is appended to each frame and would have to be "
                  "stripped before forwarding over USB")
TETHERKIT_MESSAGE(kNetSysctlWhyTso, "非 0 时会收到最大 64KB 的 TSO 巨包，超出 RNDIS 单帧上限",
                  "when non-zero, TSO super-packets of up to 64 KB arrive, exceeding the RNDIS "
                  "per-frame limit")
TETHERKIT_MESSAGE(kNetSysctlWhyLro, "非 0 时会收到被合并过的超长接收帧",
                  "when non-zero, coalesced oversized receive frames arrive")
TETHERKIT_MESSAGE(kNetSysctlWhyTrailer, "非 0 时帧尾带额外填充",
                  "when non-zero, frames carry extra trailing padding")
TETHERKIT_MESSAGE(kNetSysctlWhySeparateHeader, "非 0 时帧头与净荷分离，破坏连续内存假设",
                  "when non-zero, the frame header is separated from the payload, breaking the "
                  "contiguous-memory assumption")
